#!/usr/bin/env python3
"""BTC Watcher's data fetcher: one JSON blob with everything the widget shows.

    btc-watcher-fetch [--currency EUR] [--no-cache]

Two upstreams, because neither covers the whole job:

  mempool.space  chain data — blocks, fees, difficulty, mempool
  CoinGecko      price, because mempool.space only quotes seven currencies
                 and this widget offers all 63

Percentage changes come from a rolling 24h price history kept on disk, not
from an upstream field. CoinGecko hands out a ready-made 24h change and
nothing else, but the bar can be set to show 10m, 30m, 1h, 6h — so the
history has to exist anyway, and deriving every window from one series keeps
them consistent with each other. The upstream 24h value is still used as a
fallback until the local history is old enough to answer for itself.

The cache lives under ~/.cache and is treated as untrusted input: it is read
through O_NOFOLLOW with every check made against the opened descriptor, and
written through a create-and-hold descriptor plus atomic replace. A cache is
a file other things can reach; the shell process reading it is long-lived.
"""

import argparse
import fcntl
import http.client
import json
import os
import re
import stat
import sys
import time
import urllib.error
import urllib.request

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "btc-watcher"
)

HTTP_TIMEOUT = 6          # seconds per request
# Five upstream calls at six seconds each is half a minute of a Process the
# shell has no timeout on. One budget covers the whole run: once it is spent,
# the remaining calls are skipped and whatever was collected is returned.
TOTAL_BUDGET = 15         # seconds for everything
CHAIN_TTL = 45            # blocks arrive every ~10 min; no need to hammer
PRICE_TTL = 30
HISTORY_SPAN = 24 * 3600  # what the longest selectable window needs
HISTORY_MAX_POINTS = 6000 # a hard ceiling independent of the time span
MAX_CACHE_BYTES = 1024 * 1024
MIN_SAMPLE_TOLERANCE = 120  # s; floor of how far a sample may sit from a window start
PRICE_STALE_AFTER = 300     # s; an older cached price is shown but never alerts

MEMPOOL = "https://mempool.space/api"
COINGECKO = "https://api.coingecko.com/api/v3"

USER_AGENT = "btc-watcher (omarchy bar widget)"

# Windows the widget may ask for. Notifications are capped at 1h elsewhere;
# these are what the bar can display.
WINDOWS = {
    "10m": 600,
    "15m": 900,
    "30m": 1800,
    "1h": 3600,
    "6h": 21600,
    "12h": 43200,
    "24h": 86400,
}

CLOEXEC = getattr(os, "O_CLOEXEC", 0)

# A currency code reaches this script from the widget's settings, and from
# there it goes into a request URL and into a cache filename. Both are places
# where an unchecked string is a bug waiting to happen — "../../x" would put
# the cache outside its directory — so it is matched against what a code can
# actually look like and rejected otherwise, rather than escaped after the fact.
CURRENCY_RE = re.compile(r"^[A-Z]{2,10}$")
DEFAULT_CURRENCY = "USD"


def clean_currency(raw):
    code = str(raw or "").strip().upper()
    return code if CURRENCY_RE.match(code) else DEFAULT_CURRENCY


# ── cache, treated as untrusted input ────────────────────────────────────────

def cache_dir_ready():
    try:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    except OSError:
        return False
    try:
        st = os.lstat(CACHE_DIR)  # lstat: a symlink here fails rather than being followed
    except OSError:
        return False
    return (
        stat.S_ISDIR(st.st_mode)
        and st.st_uid == os.geteuid()
        and not st.st_mode & 0o077
    )


def read_json(path, max_age=None):
    """Return parsed JSON, or None if anything about the file is not right."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None
        if st.st_uid != os.geteuid():
            return None
        if not 0 < st.st_size <= MAX_CACHE_BYTES:
            return None
        if max_age is not None and time.time() - st.st_mtime > max_age:
            return None
        os.set_blocking(fd, True)
        body = os.read(fd, MAX_CACHE_BYTES)
    except OSError:
        return None
    finally:
        os.close(fd)

    try:
        return json.loads(body)
    except ValueError:
        return None


def write_json(path, payload):
    """Publish atomically; never reopen the temporary by name."""
    if not cache_dir_ready():
        return False
    body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    if len(body) > MAX_CACHE_BYTES:
        return False

    fd = None
    tmp = None
    try:
        for _ in range(8):
            candidate = os.path.join(
                CACHE_DIR, ".btc-watcher.%d.%s" % (os.getpid(), os.urandom(8).hex())
            )
            try:
                fd = os.open(
                    candidate,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | CLOEXEC,
                    0o600,
                )
                tmp = candidate
                break
            except FileExistsError:
                continue
        if fd is None:
            return False

        view = memoryview(body)
        written = 0
        while written < len(body):
            written += os.write(fd, view[written:])
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(tmp, path)
        tmp = None
        return True
    except OSError:
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


# ── upstreams ────────────────────────────────────────────────────────────────

STARTED = time.monotonic()


def budget_left():
    return TOTAL_BUDGET - (time.monotonic() - STARTED)


def get(url):
    remaining = budget_left()
    if remaining <= 0.5:
        return None
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=min(HTTP_TIMEOUT, remaining)) as response:
            # Bounded read: an upstream that answers with a gigabyte is a
            # denial of service against the shell process, not a data source.
            return json.loads(response.read(2 * 1024 * 1024))
    except (urllib.error.URLError, http.client.HTTPException, ValueError, OSError):
        return None


def fetch_chain():
    blocks = get(MEMPOOL + "/v1/blocks")
    fees = get(MEMPOOL + "/v1/fees/recommended")
    diff = get(MEMPOOL + "/v1/difficulty-adjustment")
    pool = get(MEMPOOL + "/mempool")
    hashrate = get(MEMPOOL + "/v1/mining/hashrate/3d")

    if not isinstance(blocks, list) or not blocks:
        return None
    tip = blocks[0]
    if not isinstance(tip, dict):
        return None
    height = tip.get("height")
    if not isinstance(height, int):
        return None

    # Halvings land every 210 000 blocks; the next one is the next multiple up.
    next_halving = ((height // 210000) + 1) * 210000
    blocks_to_halving = next_halving - height

    chain = {
        "height": height,
        "tip_ts": tip.get("timestamp") if isinstance(tip.get("timestamp"), (int, float)) else None,
        "tip_age_s": max(0, int(time.time() - tip["timestamp"])) if isinstance(tip.get("timestamp"), (int, float)) else 0,
        "halving": {
            "block": next_halving,
            "blocks_left": blocks_to_halving,
            # 10 minutes per block is the protocol's intent, not a forecast.
            "est_ts": int(time.time() + blocks_to_halving * 600),
        },
    }

    if isinstance(fees, dict):
        chain["fees"] = {
            "fastest": fees.get("fastestFee"),
            "half_hour": fees.get("halfHourFee"),
            "hour": fees.get("hourFee"),
            "economy": fees.get("economyFee"),
            "minimum": fees.get("minimumFee"),
        }
    if isinstance(diff, dict):
        chain["difficulty"] = {
            "progress_pct": diff.get("progressPercent"),
            "change_pct": diff.get("difficultyChange"),
            "remaining_blocks": diff.get("remainingBlocks"),
            "retarget_ts": (
                int(diff["estimatedRetargetDate"] // 1000)
                if isinstance(diff.get("estimatedRetargetDate"), (int, float)) else None
            ),
        }
    if isinstance(pool, dict):
        chain["mempool"] = {"count": pool.get("count"), "vsize": pool.get("vsize")}
    if isinstance(hashrate, dict):
        chain["hashrate"] = hashrate.get("currentHashrate")

    return chain


def fetch_price(currency):
    code = currency.lower()
    data = get(
        "%s/simple/price?ids=bitcoin&vs_currencies=%s&include_24hr_change=true"
        % (COINGECKO, code)
    )
    if not isinstance(data, dict):
        return None
    coin = data.get("bitcoin")
    if not isinstance(coin, dict) or code not in coin:
        return None
    value = coin[code]
    if not isinstance(value, (int, float)):
        return None
    return {
        "value": float(value),
        "upstream_24h": coin.get("%s_24h_change" % code),
        "fetched_ts": int(time.time()),
    }


def valid_price(obj):
    return (
        isinstance(obj, dict)
        and isinstance(obj.get("value"), (int, float))
        and not isinstance(obj.get("value"), bool)
    )


# ── price history ────────────────────────────────────────────────────────────

def history_path(currency):
    # Per currency: a percentage over a series that switched currency midway
    # would be an FX move dressed up as a price move.
    safe = "".join(c for c in currency.lower() if c.isalnum())
    return os.path.join(CACHE_DIR, "history-%s.json" % (safe or "usd"))


def clean_points(points, now):
    if not isinstance(points, list):
        return []
    cleaned = [
        p for p in points
        if isinstance(p, list) and len(p) == 2
        and isinstance(p[0], (int, float)) and isinstance(p[1], (int, float))
        and now - p[0] <= HISTORY_SPAN
    ]
    cleaned.sort(key=lambda p: p[0])
    return cleaned


def update_history(currency, price, now):
    path = history_path(currency)
    cleaned = clean_points(read_json(path), now)
    cleaned.append([int(now), price])
    cleaned.sort(key=lambda p: p[0])
    if len(cleaned) > HISTORY_MAX_POINTS:
        cleaned = cleaned[-HISTORY_MAX_POINTS:]

    write_json(path, cleaned)
    return cleaned


def changes_from(points, price, now, upstream_24h):
    """Percentage change per window, or None when the series is too short."""
    out = {}
    span = now - points[0][0] if points else 0

    for name, seconds in WINDOWS.items():
        if span < seconds * 0.9:
            # Not enough history yet. The one window an upstream can answer.
            out[name] = upstream_24h if name == "24h" else None
            continue
        target = now - seconds
        # The sample nearest the window's start; the series is sorted.
        best = min(points, key=lambda p: abs(p[0] - target))
        # After a suspend the nearest sample can be hours from the window's
        # start; that would be a different window's change, not this one's.
        if abs(best[0] - target) > max(seconds * 0.25, MIN_SAMPLE_TOLERANCE):
            out[name] = upstream_24h if name == "24h" else None
            continue
        if best[1] <= 0:
            out[name] = None
            continue
        out[name] = (price - best[1]) / best[1] * 100.0

    return out, int(span)


# ── supported currencies ─────────────────────────────────────────────────────

# Enough to configure the widget with no network at all. The live list is
# fetched when it can be, because CoinGecko adds quote currencies over time and
# a baked-in list would quietly go stale.
FALLBACK_CURRENCIES = [
    "AUD", "BRL", "CAD", "CHF", "CNY", "CZK", "DKK", "EUR", "GBP", "HKD",
    "HUF", "IDR", "ILS", "INR", "JPY", "KRW", "MXN", "MYR", "NOK", "NZD",
    "PHP", "PLN", "RUB", "SEK", "SGD", "THB", "TRY", "TWD", "USD", "ZAR",
]

CURRENCIES_TTL = 7 * 24 * 3600

# Quote "currencies" that are Bitcoin units or other coins: a BTC price in BTC
# is 1, and a fee in them rounds to zero.
NOT_FIAT = {"BTC", "SATS", "BITS", "ETH", "LTC", "BCH", "BNB", "EOS", "XRP", "XLM", "LINK", "DOT", "YFI"}


def list_currencies():
    path = os.path.join(CACHE_DIR, "currencies.json")
    cached = read_json(path, max_age=CURRENCIES_TTL)

    if not isinstance(cached, list) or not cached:
        fetched = get(COINGECKO + "/simple/supported_vs_currencies")
        if isinstance(fetched, list) and fetched:
            cached = sorted(
                c.upper() for c in fetched
                if isinstance(c, str) and c.isalpha() and len(c) <= 5
                and c.upper() not in NOT_FIAT
            )
            write_json(path, cached)
        else:
            cached = FALLBACK_CURRENCIES

    for code in cached:
        sys.stdout.write(code + "\n")
    return 0


# ── alert de-duplication ─────────────────────────────────────────────────────

def claim_alert(direction, cooldown):
    """True if this caller may notify. The shell runs one widget per monitor;
    all of them poll, so who alerts is decided here, under a file lock."""
    if direction not in ("up", "down") or not cache_dir_ready():
        return False
    path = os.path.join(CACHE_DIR, "alerts.lock")
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | CLOEXEC, 0o600)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
            return False
        fcntl.flock(fd, fcntl.LOCK_EX)
        raw = os.read(fd, 4096)
        try:
            state = json.loads(raw) if raw else {}
        except ValueError:
            state = {}
        if not isinstance(state, dict):
            state = {}
        now = time.time()
        last = state.get(direction)
        if isinstance(last, (int, float)) and 0 <= now - last < cooldown:
            return False
        state[direction] = now
        os.lseek(fd, 0, os.SEEK_SET)
        os.ftruncate(fd, 0)
        os.write(fd, json.dumps(state).encode("utf-8"))
        return True
    except OSError:
        return False
    finally:
        os.close(fd)  # also releases the lock


# ── main ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(add_help=True, description=__doc__)
    parser.add_argument("--currency", default="EUR")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument(
        "--currencies",
        action="store_true",
        help="list the quote currencies CoinGecko accepts, one per line",
    )
    parser.add_argument("--claim-alert", choices=("up", "down"))
    parser.add_argument("--cooldown", type=float, default=1800)
    args = parser.parse_args()

    if args.claim_alert:
        sys.stdout.write("yes\n" if claim_alert(args.claim_alert, max(0, args.cooldown)) else "no\n")
        return 0

    if args.currencies:
        return list_currencies()

    currency = str(args.currency or "").strip().upper()
    if not CURRENCY_RE.match(currency):
        json.dump(
            {"ok": False, "error": "Invalid currency code: %r" % args.currency[:16]},
            sys.stdout,
        )
        sys.stdout.write("\n")
        return 1
    now = time.time()
    chain_cache = os.path.join(CACHE_DIR, "chain.json")
    price_cache = os.path.join(CACHE_DIR, "price-%s.json" % currency.lower())

    # Price first: it is the core of the widget, and a slow chain upstream
    # must not spend the whole budget before it is asked.
    price = None if args.no_cache else read_json(price_cache, max_age=PRICE_TTL)
    price = price if valid_price(price) else None
    fresh_price = False
    stale = False
    if price is None:
        price = fetch_price(currency)
        if price is not None:
            write_json(price_cache, price)
            fresh_price = True
        else:
            price = read_json(price_cache)
            price = price if valid_price(price) else None
            stale = price is not None

    chain = None if args.no_cache else read_json(chain_cache, max_age=CHAIN_TTL)
    if not isinstance(chain, dict):
        chain = None
    if chain is None:
        try:
            chain = fetch_chain()
        except (TypeError, ValueError, AttributeError, KeyError):
            chain = None  # an upstream field of an unexpected type
        if chain is not None:
            write_json(chain_cache, chain)
        else:
            # Stale beats blank: the bar keeps its last known height rather
            # than emptying itself over one failed request.
            chain = read_json(chain_cache)
            if not isinstance(chain, dict):
                chain = None

    result = {"ok": False, "ts": int(now), "currency": currency}

    if chain:
        # The cached copy may be hours old (offline fallback): age it now.
        if isinstance(chain.get("tip_ts"), (int, float)):
            chain["tip_age_s"] = max(0, int(now - chain["tip_ts"]))
        result["chain"] = chain
    if price:
        if fresh_price:
            points = update_history(currency, price["value"], now)
        else:
            points = clean_points(read_json(history_path(currency)), now)
        changes, span = changes_from(
            points, price["value"], now, price.get("upstream_24h")
        )
        fetched = price.get("fetched_ts")
        age = int(now - fetched) if isinstance(fetched, (int, float)) else None
        # A price the upstream would not refresh is shown, but flagged: the
        # widget must not raise an alert over a reading that is not new.
        stale = stale and (age is None or age > PRICE_STALE_AFTER)
        result["price"] = {
            "value": price["value"],
            "change": changes,
            "history_span_s": span,
            "stale": stale,
            "age_s": age,
        }

    result["ok"] = bool(chain or price)
    json.dump(result, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
